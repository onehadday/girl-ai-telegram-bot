# Найкращий безкоштовний старт:
GEMINI_API_KEY=твій_gemini_ключ_сюди
GEMINI_MODEL=gemini-2.0-flash-lite

# Альтернатива з безкоштовними моделями:
OPENROUTER_API_KEY=твій_openrouter_ключ_сюди
OPENROUTER_MODEL=openrouter/free

# Платний запасний варіант:
OPENAI_API_KEY=твій_openai_ключ_сюди
OPENAI_MODEL=gpt-4.1-mini

PORT=8000

# Telegram bot:
TELEGRAM_BOT_TOKEN=твій_токен_від_BotFather

# Необов'язково: ID твого Telegram-акаунта, якщо хочеш колись знову закрити бота.
# Зараз бот у коді відкритий для всіх.
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_WEBHOOK_SECRET=будь_який_довгий_секретний_рядок
PUBLIC_URL=https://твій-сервіс.onrender.com

# Необов'язково: email, який завжди буде адміном після реєстрації.
ADMIN_EMAIL=

# Supabase/Postgres. Якщо додати DATABASE_URL, сайт зберігатиме користувачів та історію в Supabase.
DATABASE_URL=
